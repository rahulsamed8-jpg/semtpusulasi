---
import '../styles/global.css';
import CookieBanner from '../components/CookieBanner.astro';

const { title, description, image = 'https://lh5.googleusercontent.com/p/AF1QipN3u23yBntxQxY3Yw_A3nJzWw-g9M7M-2k_nB_=w800-h400-k-no' } = Astro.props;

// Canonical URL oluşturma
const site = 'https://semtpusulasi.com';
const canonicalURL = new URL(Astro.url.pathname, site);
---
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/logo.png" />
    <meta name="google-site-verification" content="H97v-1dQI2Imefp0prMvphAAySTj__6Do24TkIGYHUc" />
    
    <!-- Netlify Identity Widget for CMS -->
    <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>

    <title>{title}</title>

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Preload Hero Image -->
    <link rel="preload" as="image" href="/arkaplan.webp" fetchpriority="high" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Google Tag Manager ve AdSense (Geç Yükleme - Performans İçin) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-HXT0CZKDPF');

      setTimeout(() => {
          // GA4
          const ga = document.createElement('script');
          ga.src = "https://www.googletagmanager.com/gtag/js?id=G-HXT0CZKDPF";
          ga.async = true;
          document.head.appendChild(ga);

          // Adsense
          const ads = document.createElement('script');
          ads.src = "https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8917924197167442";
          ads.crossOrigin = "anonymous";
          ads.async = true;
          document.head.appendChild(ads);
      }, 3500); // Sayfa yüklendikten 3.5 sn sonra yükle ki LCP'yi engellemesin
    </script>
</head>
<body class="bg-slate-50 text-slate-900 font-sans min-h-screen flex flex-col">
    <!-- Header -->
    <header class="bg-white shadow-sm sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <a href="/" class="flex items-center" aria-label="SemtPusulası Ana Sayfa">
                <img src="/logo.svg" alt="SemtPusulası Logo" width="180" height="56" class="h-12 sm:h-14 w-auto transform transition-transform hover:scale-105" />
            </a>
            
            <!-- Arama Butonu (Masaüstü) - Canlı Arama Destekli -->
            <div class="flex-1 max-w-md mx-8 relative hidden md:block z-50">
                <form action="/arama" method="GET" class="relative">
                    <input type="text" name="q" id="header-search-input" aria-label="Arama kutusu" autocomplete="off" placeholder="Mekan, plaj, otel ara..." class="w-full bg-slate-100 rounded-xl py-2 pl-4 pr-10 border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition-all text-sm font-medium" />
                    <button type="submit" aria-label="Arama yap" class="absolute right-2 top-1 p-2 text-slate-400 hover:text-blue-600 transition-colors">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                    </button>
                </form>
                
                <!-- Canlı Arama Sonuçları (Header) -->
                <div id="header-search-results" class="absolute top-full left-0 right-0 mt-2 bg-white rounded-xl shadow-2xl overflow-hidden hidden max-h-[400px] overflow-y-auto text-left border border-slate-100 divide-y divide-slate-100">
                    <!-- JS ile doldurulacak -->
                </div>
            </div>

            <nav class="hidden md:flex space-x-6 items-center">
                <a href="/" class="text-sm text-slate-600 hover:text-blue-600 font-bold transition-colors">Ana Sayfa</a>
                <a href="/rehber" class="text-sm text-slate-600 hover:text-blue-600 font-bold transition-colors">Gezi Rehberi</a>
                <a href="/hakkimizda" class="text-sm text-slate-600 hover:text-blue-600 font-bold transition-colors">Hakkımızda</a>
                <a href="/iletisim" class="bg-blue-50 text-blue-600 px-4 py-2 rounded-lg text-sm font-bold hover:bg-blue-100 transition-colors">İletişim</a>
            </nav>

            <!-- Mobil Menü Butonu (Hamburger) -->
            <button id="mobile-menu-btn" class="md:hidden p-2 text-slate-600 hover:text-blue-600 focus:outline-none transition-transform active:scale-95" aria-label="Menüyü Aç">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
            </button>
        </div>

        <!-- Mobil Menü İçeriği (Sidebar Overlay) -->
        <div id="mobile-menu" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-[100] hidden opacity-0 transition-opacity duration-300">
            <div class="absolute right-0 top-0 bottom-0 w-64 bg-white shadow-2xl transform translate-x-full transition-transform duration-300 flex flex-col" id="mobile-menu-sidebar">
                <div class="p-4 flex justify-between items-center border-b border-slate-100 bg-slate-50">
                    <span class="font-extrabold text-slate-800 text-lg">Menü</span>
                    <button id="mobile-menu-close" class="p-2 bg-white rounded-full text-slate-400 hover:text-red-500 hover:bg-red-50 transition-colors shadow-sm" aria-label="Menüyü Kapat">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                    </button>
                </div>
                <nav class="flex flex-col p-6 space-y-6 flex-grow">
                    <a href="/" class="text-lg font-bold text-slate-800 hover:text-blue-600 transition-colors flex items-center gap-3"><span class="text-blue-500">🏠</span> Ana Sayfa</a>
                    <a href="/rehber" class="text-lg font-bold text-slate-800 hover:text-blue-600 transition-colors flex items-center gap-3"><span class="text-blue-500">🗺️</span> Gezi Rehberi</a>
                    <a href="/hakkimizda" class="text-lg font-bold text-slate-800 hover:text-blue-600 transition-colors flex items-center gap-3"><span class="text-blue-500">ℹ️</span> Hakkımızda</a>
                    <a href="/iletisim" class="text-lg font-bold text-slate-800 hover:text-blue-600 transition-colors flex items-center gap-3"><span class="text-blue-500">📞</span> İletişim</a>
                    
                    <div class="pt-8 border-t border-slate-100 mt-auto">
                        <p class="text-xs font-bold text-slate-400 mb-3 uppercase tracking-wider">Hızlı Arama</p>
                        <form action="/arama" method="GET" class="relative">
                            <input type="text" name="q" id="mobile-search-input" autocomplete="off" placeholder="Mekan, otel, plaj ara..." class="w-full bg-slate-50 rounded-xl py-3 pl-4 pr-10 border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm shadow-inner" />
                            <button type="submit" class="absolute right-3 top-2.5 text-slate-400 hover:text-blue-600 transition-colors">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                            </button>
                        </form>
                        <!-- Mobil Canlı Arama Sonuçları -->
                        <div id="mobile-search-results" class="absolute bottom-full mb-2 left-4 right-4 bg-white rounded-xl shadow-2xl overflow-hidden hidden max-h-[300px] overflow-y-auto text-left border border-slate-100 divide-y divide-slate-100 z-50"></div>
                    </div>
                </nav>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow w-full">
        <slot />
    </main>

    <!-- Footer (Premium Tasarım) -->
    <footer class="bg-[#0B1120] text-slate-300 py-16 mt-auto border-t-4 border-blue-600">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-4 gap-12">
            <!-- Hakkında & Logo -->
            <div class="col-span-1 md:col-span-1">
                <a href="/" class="inline-block mb-4 bg-white/5 p-3 rounded-2xl hover:bg-white/10 transition-colors">
                    <img src="/logo.svg" alt="SemtPusulası" width="150" height="40" class="h-10 w-auto brightness-0 invert" />
                </a>
                <p class="text-sm text-slate-400 leading-relaxed mb-6">
                    Türkiye'nin en kapsamlı, güncel ve güvenilir yerel rehberi. Keşfedilmeyi bekleyen binlerce mekanı sizin için listeliyoruz.
                </p>
                <!-- Sosyal Medya İkonları -->
                <div class="flex gap-4">
                    <a href="https://www.facebook.com/profile.php?id=61591376949858" target="_blank" aria-label="Facebook" class="w-12 h-12 rounded-full bg-slate-800 flex items-center justify-center text-slate-400 hover:bg-blue-600 hover:text-white transition-all transform hover:-translate-y-1">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/></svg>
                    </a>
                    <a href="https://www.instagram.com/semtpusulasi/" target="_blank" aria-label="Instagram" class="w-12 h-12 rounded-full bg-slate-800 flex items-center justify-center text-slate-400 hover:bg-pink-600 hover:text-white transition-all transform hover:-translate-y-1">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                    </a>
                    <a href="https://www.tiktok.com/@semt.pusulasi" target="_blank" aria-label="TikTok" class="w-12 h-12 rounded-full bg-slate-800 flex items-center justify-center text-slate-400 hover:bg-black hover:text-white transition-all transform hover:-translate-y-1">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1.04-.1z"/></svg>
                    </a>
                </div>
            </div>

            <!-- Hızlı Menü -->
            <div>
                <h3 class="text-lg font-bold text-white mb-6 uppercase tracking-wider text-sm">Hızlı Menü</h3>
                <ul class="space-y-3 text-sm font-medium text-slate-400">
                    <li><a href="/" class="hover:text-blue-400 transition-colors flex items-center gap-2"><span class="text-blue-600">▪</span> Ana Sayfa</a></li>
                    <li><a href="/rehber" class="hover:text-blue-400 transition-colors flex items-center gap-2"><span class="text-blue-600">▪</span> Gezi Rehberi</a></li>
                    <li><a href="/kategori/oteller" class="hover:text-blue-400 transition-colors flex items-center gap-2"><span class="text-blue-600">▪</span> En İyi Oteller</a></li>
                    <li><a href="/kategori/plajlar" class="hover:text-blue-400 transition-colors flex items-center gap-2"><span class="text-blue-600">▪</span> Gizli Plajlar</a></li>
                    <li><a href="/kategori/mekanlar" class="hover:text-blue-400 transition-colors flex items-center gap-2"><span class="text-blue-600">▪</span> Popüler Mekanlar</a></li>
                </ul>
            </div>

            <!-- İletişim Bilgileri (YENİ) -->
            <div>
                <h3 class="text-lg font-bold text-white mb-6 uppercase tracking-wider text-sm">İletişim</h3>
                <ul class="space-y-4 text-sm text-slate-400">
                    <li class="flex items-start gap-3">
                        <span class="mt-0.5 text-blue-500">📍</span> 
                        <span>Dumlupınar Mah. 359. Sokak No:12 Daire:1<br/>09800 Aydın, Türkiye</span>
                    </li>
                    <li class="flex items-center gap-3 hover:text-white transition-colors cursor-pointer">
                        <span class="text-blue-500">📞</span> 
                        <a href="tel:05528077286">0552 807 72 86</a>
                    </li>
                    <li class="flex items-center gap-3 hover:text-white transition-colors cursor-pointer">
                        <span class="text-blue-500">✉️</span> 
                        <a href="mailto:iletisim@semtpusulasi.com">iletisim@semtpusulasi.com</a>
                    </li>
                </ul>
            </div>

            <!-- Yasal -->
            <div>
                <h3 class="text-lg font-bold text-white mb-6 uppercase tracking-wider text-sm">Yasal</h3>
                <ul class="space-y-3 text-sm font-medium text-slate-400">
                    <li><a href="/gizlilik" class="hover:text-white transition-colors">Gizlilik Politikası</a></li>
                    <li><a href="/kullanim-kosullari" class="hover:text-white transition-colors">Kullanım Koşulları</a></li>
                    <li><a href="/cerezler" class="hover:text-white transition-colors">Çerez Politikası</a></li>
                </ul>
            </div>
        </div>
        
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-12 pt-8 border-t border-slate-800/50 text-sm flex flex-col md:flex-row items-center justify-between text-slate-400">
            <p>&copy; {new Date().getFullYear()} SemtPusulası. Tüm hakları saklıdır.</p>
            <p class="mt-2 md:mt-0">Made with ❤️ in Turkey</p>
        </div>
    </footer>
    <CookieBanner />

    <!-- Akıllı Arama Motoru (Smart Search) JS Mantığı -->
    <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            const searchInputs = [document.getElementById('header-search-input'), document.getElementById('mobile-search-input')].filter(Boolean);
            const resultsContainers = [document.getElementById('header-search-results'), document.getElementById('mobile-search-results')].filter(Boolean);
            let searchData = null;
            let isLoading = false;

            const normalize = (str) => {
                if(!str) return '';
                return str.toLowerCase()
                  .replace(/ğ/g, 'g').replace(/ü/g, 'u').replace(/ş/g, 's')
                  .replace(/ı/g, 'i').replace(/ö/g, 'o').replace(/ç/g, 'c')
                  .replace(/[^a-z0-9]/g, '');
            };

            const trendingHTML = `
                <div class="p-4 bg-slate-50/50">
                    <p class="text-xs font-bold text-slate-400 mb-3 uppercase tracking-wider flex items-center gap-2"><span class="text-orange-500 text-base">🔥</span> Popüler Aramalar</p>
                    <div class="flex flex-wrap gap-2">
                        <span class="trending-badge bg-white border border-slate-200 text-slate-600 px-3 py-1.5 rounded-lg text-xs font-bold cursor-pointer hover:border-blue-500 hover:text-blue-600 transition-all shadow-sm">Akarca Plajı</span>
                        <span class="trending-badge bg-white border border-slate-200 text-slate-600 px-3 py-1.5 rounded-lg text-xs font-bold cursor-pointer hover:border-blue-500 hover:text-blue-600 transition-all shadow-sm">Teos Marina</span>
                        <span class="trending-badge bg-white border border-slate-200 text-slate-600 px-3 py-1.5 rounded-lg text-xs font-bold cursor-pointer hover:border-blue-500 hover:text-blue-600 transition-all shadow-sm">Oteller</span>
                        <span class="trending-badge bg-white border border-slate-200 text-slate-600 px-3 py-1.5 rounded-lg text-xs font-bold cursor-pointer hover:border-blue-500 hover:text-blue-600 transition-all shadow-sm">Gümüldür Aquapark</span>
                    </div>
                </div>
            `;

            const loadSearchData = async () => {
                if (searchData || isLoading) return;
                isLoading = true;
                try {
                    const res = await fetch('/search.json');
                    searchData = await res.json();
                } catch (e) {
                    console.error("Arama verisi yüklenemedi", e);
                }
                isLoading = false;
            };

            document.addEventListener('click', (e) => {
                searchInputs.forEach((input, index) => {
                    const container = resultsContainers[index];
                    if (input && container && !input.contains(e.target) && !container.contains(e.target)) {
                        container.classList.add('hidden');
                    }
                });
            });

            searchInputs.forEach((searchInput, index) => {
                const resultsContainer = resultsContainers[index];
                if(!resultsContainer) return;

                const renderTrending = () => {
                    resultsContainer.innerHTML = trendingHTML;
                    resultsContainer.classList.remove('hidden');
                    
                    // Click events for trending badges
                    const badges = resultsContainer.querySelectorAll('.trending-badge');
                    badges.forEach(badge => {
                        badge.addEventListener('click', () => {
                            searchInput.value = badge.textContent;
                            searchInput.dispatchEvent(new Event('input'));
                        });
                    });
                };

                searchInput.addEventListener('input', (e) => {
                    const rawQuery = e.target.value.trim();
                    const query = normalize(rawQuery);
                    
                    if (rawQuery.length === 0) {
                        renderTrending();
                        return;
                    }
                    if (rawQuery.length < 2 || !searchData) {
                        resultsContainer.classList.add('hidden');
                        return;
                    }
                    
                    // Fuzzy Search & Category Boost
                    const matches = searchData.map(item => {
                        let score = 0;
                        const normName = normalize(item.name);
                        const normRegion = normalize(item.region);
                        const normCat = normalize(item.category);
                        
                        if (normName.includes(query)) score += 10;
                        if (normCat.includes(query)) score += 5; // "Otel" yazınca oteller üste çıksın
                        if (normRegion.includes(query)) score += 3;
                        
                        return { ...item, score };
                    }).filter(item => item.score > 0)
                      .sort((a, b) => b.score - a.score || b.rating - a.rating)
                      .slice(0, 6);
                    
                    if (matches.length > 0) {
                        resultsContainer.innerHTML = matches.map(item => `
                            <a href="/mekan/${item.slug}" class="flex items-center gap-3 p-3 hover:bg-slate-50 transition-colors group">
                                <div class="w-12 h-12 rounded-lg bg-slate-100 overflow-hidden shrink-0 border border-slate-200">
                                    ${item.photos && item.photos.length > 0 
                                        ? `<img src="${item.photos[0]}" alt="${item.name}" width="48" height="48" loading="lazy" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300" />` 
                                        : `<div class="flex items-center justify-center h-full text-lg">📍</div>`}
                                </div>
                                <div class="flex flex-col flex-1 min-w-0">
                                    <span class="font-extrabold text-slate-800 text-sm truncate group-hover:text-blue-600 transition-colors">${item.name}</span>
                                    <div class="flex items-center justify-between mt-0.5">
                                        <span class="text-[11px] text-slate-500 font-medium truncate">${item.region} • ${item.category}</span>
                                        ${item.rating > 0 ? `<span class="flex items-center text-[11px] font-bold text-amber-500 ml-2">⭐ ${item.rating}</span>` : ''}
                                    </div>
                                </div>
                            </a>
                        `).join('');
                        
                        resultsContainer.innerHTML += `
                            <button onclick="window.location.href='/arama?q=${encodeURIComponent(rawQuery)}'" class="w-full p-3 bg-slate-50 text-blue-600 text-xs font-bold hover:bg-blue-100 transition-colors border-t border-slate-100 flex items-center justify-center gap-1">
                                "${rawQuery}" için tüm sonuçları gör <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                            </button>
                        `;
                        resultsContainer.classList.remove('hidden');
                    } else {
                        resultsContainer.innerHTML = `
                            <div class="p-6 text-center flex flex-col items-center">
                                <div class="w-12 h-12 bg-slate-100 rounded-full flex items-center justify-center text-slate-400 mb-3">
                                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                                </div>
                                <p class="text-sm font-bold text-slate-700">Sonuç bulunamadı</p>
                                <p class="text-xs text-slate-500 mt-1">Farklı bir kelime ile tekrar deneyin.</p>
                            </div>
                        `;
                        resultsContainer.classList.remove('hidden');
                    }
                });
                
                searchInput.addEventListener('focus', async (e) => {
                    await loadSearchData();
                    if (e.target.value.length === 0) {
                        renderTrending();
                    } else if (e.target.value.length >= 2) {
                        searchInput.dispatchEvent(new Event('input'));
                    }
                });
            });
            
            // Mobil Menü İşlemleri
            const mobileMenuBtn = document.getElementById('mobile-menu-btn');
            const mobileMenuClose = document.getElementById('mobile-menu-close');
            const mobileMenu = document.getElementById('mobile-menu');
            const mobileMenuSidebar = document.getElementById('mobile-menu-sidebar');

            if (mobileMenuBtn && mobileMenuClose && mobileMenu && mobileMenuSidebar) {
                mobileMenuBtn.addEventListener('click', () => {
                    mobileMenu.classList.remove('hidden');
                    // Küçük bir gecikme ekleyerek CSS transition'un tetiklenmesini sağlıyoruz
                    requestAnimationFrame(() => {
                        mobileMenu.classList.remove('opacity-0');
                        mobileMenuSidebar.classList.remove('translate-x-full');
                    });
                    document.body.style.overflow = 'hidden'; // Arka planın kaymasını engelle
                });

                const closeMenu = () => {
                    mobileMenu.classList.add('opacity-0');
                    mobileMenuSidebar.classList.add('translate-x-full');
                    document.body.style.overflow = '';
                    setTimeout(() => {
                        mobileMenu.classList.add('hidden');
                    }, 300); // 300ms transition duration ile aynı olmalı
                };

                mobileMenuClose.addEventListener('click', closeMenu);
                mobileMenu.addEventListener('click', (e) => {
                    if (e.target === mobileMenu) closeMenu();
                });
            }
        });
    </script>
        <!-- Netlify Identity Redirect -->
        <script is:inline>
          if (window.netlifyIdentity) {
            window.netlifyIdentity.on("init", user => {
              if (!user) {
                window.netlifyIdentity.on("login", () => {
                  document.location.href = "/admin/";
                });
              }
            });
          }
        </script>
    </body>
</html>
