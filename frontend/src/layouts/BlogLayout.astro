---
import Layout from './Layout.astro';

const { frontmatter, headings } = Astro.props;
// Sadece H2 ve H3 başlıklarını filtrele (TOC için)
const tocHeadings = headings ? headings.filter((h) => h.depth === 2 || h.depth === 3) : [];
---

<Layout title={`${frontmatter.title} | SemtPusulası Rehber`} description={frontmatter.description} image={frontmatter.image}>
    <!-- Hero Section -->
    <div class="relative h-[400px] w-full bg-slate-900 overflow-hidden">
        <img src={frontmatter.image} alt={frontmatter.title} class="w-full h-full object-cover opacity-60" />
        <div class="absolute inset-0 bg-gradient-to-t from-[#0B1120] to-transparent"></div>
        <div class="absolute bottom-0 left-0 w-full p-8 md:p-16 text-center">
            <h1 class="text-4xl md:text-5xl font-extrabold text-white mb-4 leading-tight">{frontmatter.title}</h1>
            <p class="text-lg md:text-xl text-slate-300 max-w-3xl mx-auto">{frontmatter.description}</p>
        </div>
    </div>

    <!-- Article Content Wrapper -->
    <div class="max-w-7xl mx-auto px-4 py-12 flex flex-col lg:flex-row gap-8">
        
        <!-- Sidebar TOC (Masaüstü için İçindekiler) -->
        <aside class="hidden lg:block w-72 shrink-0">
            <div class="sticky top-24 bg-white rounded-2xl shadow-sm border border-slate-100 p-6">
                <h3 class="text-lg font-bold text-slate-900 mb-4 pb-4 border-b border-slate-100">İçindekiler</h3>
                <ul class="space-y-3 text-sm">
                    {tocHeadings.map((heading) => (
                        <li class={`${heading.depth === 3 ? 'ml-4 text-slate-500' : 'font-semibold text-slate-700'}`}>
                            <a href={`#${heading.slug}`} class="hover:text-blue-600 transition-colors block">
                                {heading.text}
                            </a>
                        </li>
                    ))}
                </ul>
            </div>
        </aside>

        <!-- Main Content -->
        <article class="flex-grow min-w-0">
            <div class="bg-white rounded-2xl shadow-xl p-8 md:p-12 -mt-24 relative z-10 prose prose-lg prose-slate max-w-none prose-headings:font-bold prose-headings:text-slate-800 prose-headings:scroll-mt-24 prose-a:text-blue-600 hover:prose-a:text-blue-800 prose-img:rounded-xl prose-img:shadow-md">
                
                <!-- Author & Date Info (Tepe) -->
                <div class="flex items-center gap-4 mb-8 pb-8 border-b border-slate-100">
                    <div class="w-12 h-12 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center font-bold text-xl">
                        SP
                    </div>
                    <div>
                        <div class="font-bold text-slate-800">SemtPusulası Editör Ekibi</div>
                        <div class="text-sm text-slate-500">{frontmatter.date} • {frontmatter.readTime} Okuma</div>
                    </div>
                </div>

                <slot />

                <!-- E-A-T Author Box (Alt Kısım - SEO Güveni İçin) -->
                <div class="mt-16 pt-8 border-t border-slate-100 flex flex-col md:flex-row gap-6 items-center md:items-start bg-slate-50 p-6 rounded-2xl not-prose">
                    <div class="w-20 h-20 bg-blue-600 text-white rounded-full flex items-center justify-center font-bold text-3xl shrink-0">
                        SP
                    </div>
                    <div>
                        <h4 class="text-xl font-bold text-slate-900 mb-2 m-0">SemtPusulası Editör Ekibi</h4>
                        <p class="text-slate-600 text-base m-0 leading-relaxed">
                            Biz, Ege'nin saklı cennetlerini adım adım gezen, en taze deniz ürünlerinin, en serin plajların ve en rahat yastıkların peşinden koşan yerel bir gezgin grubuyuz. Bu rehberdeki her detay bizzat deneyimlenerek sizin için hazırlanmıştır.
                        </p>
                    </div>
                </div>
            </div>
        </article>
    </div>

    <!-- Sıkça Sorulan Sorular FAQ Schema Enjeksiyonu -->
    {frontmatter.faq && (
        <script type="application/ld+json" set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "FAQPage",
            "mainEntity": frontmatter.faq.map(item => ({
                "@type": "Question",
                "name": item.question,
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": item.answer
                }
            }))
        })} />
    )}
</Layout>
