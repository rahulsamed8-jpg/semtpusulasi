---
<div id="cookie-banner" class="fixed bottom-0 left-0 right-0 bg-slate-900 text-slate-300 p-2.5 sm:p-4 shadow-2xl z-50 transform transition-transform duration-300 translate-y-full">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3 sm:gap-4">
        <div class="text-[11px] sm:text-sm leading-tight text-center sm:text-left">
            <p><strong class="text-white">Çerez Politikası:</strong> Size en iyi deneyimi sunabilmek ve reklamları kişiselleştirmek için çerezleri kullanıyoruz. Sitemizi kullanarak <a href="/gizlilik" class="text-blue-400 hover:text-blue-300 underline">Gizlilik Politikamızı</a> kabul etmiş sayılırsınız.</p>
        </div>
        <div class="w-full sm:w-auto shrink-0">
            <button id="accept-cookies" class="w-full sm:w-auto bg-blue-600 hover:bg-blue-700 text-white px-4 py-1.5 sm:px-6 sm:py-2 rounded sm:rounded-lg text-xs sm:text-sm font-semibold transition-colors">
                Kabul Et
            </button>
        </div>
    </div>
</div>

<script>
    // Sadece istemcide çalışır (No SSR errors)
    const banner = document.getElementById('cookie-banner');
    const acceptBtn = document.getElementById('accept-cookies');

    if (banner && acceptBtn) {
        // Çerez daha önce kabul edildiyse gösterme
        if (!localStorage.getItem('cookiesAccepted')) {
            // Animasyonlu çıkış için küçük bir gecikme
            setTimeout(() => {
                banner.classList.remove('translate-y-full');
            }, 1000);
        }

        acceptBtn.addEventListener('click', () => {
            localStorage.setItem('cookiesAccepted', 'true');
            banner.classList.add('translate-y-full');
        });
    }
</script>
