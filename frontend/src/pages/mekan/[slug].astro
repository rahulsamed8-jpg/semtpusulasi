---
import Layout from '../../layouts/Layout.astro';
import dataRaw from '../../data/turizm_data.json';
const data = dataRaw.places;
import { marked } from 'marked';
import AdSensePlaceholder from '../../components/AdSensePlaceholder.astro';

export async function getStaticPaths() {
  return dataRaw.places.map((item) => {
    return {
      params: { slug: item.slug },
      props: { item },
    };
  });
}

const { item } = Astro.props;
const articleHTML = item.seo_article ? marked.parse(item.seo_article) : null;
const ogImage = item.photos && item.photos.length > 0 ? item.photos[0] : undefined;

// Schema Markup (JSON-LD)
const schemaType = item.category.toLowerCase().includes('otel') ? "Hotel" : 
                   item.category.toLowerCase().includes('plaj') ? "Beach" : 
                   item.category.toLowerCase().includes('restoran') ? "Restaurant" : "LocalBusiness";

const localBusinessSchema: any = {
  "@context": "https://schema.org",
  "@type": schemaType,
  "name": item.name,
  "image": item.photos && item.photos.length > 0 ? item.photos[0] : "https://semtpusulasi.com/logo.png",
  "@id": `https://semtpusulasi.com/mekan/${item.slug}`,
  "url": `https://semtpusulasi.com/mekan/${item.slug}`,
  "telephone": item.phone || "",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": item.address || "",
    "addressLocality": item.region || "",
    "addressRegion": "İzmir",
    "addressCountry": "TR"
  }
};

// Eğer puan varsa AggregateRating ekle (Sarı Yıldızlar için kritik)
if (item.rating) {
    localBusinessSchema.aggregateRating = {
        "@type": "AggregateRating",
        "ratingValue": item.rating.toString().replace(',', '.'),
        "reviewCount": item.reviews_count ? parseInt(item.reviews_count.toString().replace(/[^0-9]/g, ''), 10) || 1 : 1
    };
}

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [{
    "@type": "ListItem",
    "position": 1,
    "name": "Ana Sayfa",
    "item": "https://semtpusulasi.com/"
  },{
    "@type": "ListItem",
    "position": 2,
    "name": item.category,
    "item": `https://semtpusulasi.com/kategori/${item.category.toLowerCase().replace(' ', '-')}`
  },{
    "@type": "ListItem",
    "position": 3,
    "name": item.name,
    "item": `https://semtpusulasi.com/mekan/${item.slug}`
  }]
};
---

<Layout title={`${item.name} - ${item.region} | SemtPusulası`} description={`${item.region} bölgesindeki ${item.name} hakkında bilgiler, fotoğraflar ve yorumlar.`} image={ogImage}>
    
    <!-- Yapısal Veri (JSON-LD Schemas) -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

    <div class="max-w-7xl mx-auto mt-8 px-4 mb-24 flex flex-col lg:flex-row gap-8">
        
        <!-- SOL/ANA İÇERİK (Makale ve Detaylar) -->
        <div class="w-full lg:w-3/4">
            <div class="bg-white p-6 md:p-8 rounded-2xl shadow-sm border border-slate-100">
                <!-- Breadcrumbs -->
                <nav class="text-sm text-slate-500 mb-6">
                    <a href="/" class="hover:text-blue-600">Ana Sayfa</a> &gt; 
                    <a href={`/kategori/${item.category.toLowerCase().replace(' ', '-')}`} class="hover:text-blue-600">{item.category}</a> &gt; 
                    <span class="text-slate-800 font-medium">{item.name}</span>
                </nav>

                <!-- Başlık ve Puan -->
                <div class="flex flex-col md:flex-row md:items-start justify-between gap-4 mb-8">
                    <div>
                        <h1 class="text-3xl md:text-4xl font-bold text-slate-900 mb-2">{item.name}</h1>
                        <div class="flex items-center gap-2 text-sm">
                            <span class="bg-blue-100 text-blue-800 px-3 py-1 rounded-full font-medium">{item.category}</span>
                            <span class="text-slate-500">📍 {item.region}</span>
                        </div>
                    </div>
                    
                    <div class="bg-yellow-50 border border-yellow-200 rounded-xl p-3 flex items-center gap-3 md:min-w-[150px]">
                        <div class="text-3xl">⭐</div>
                        <div>
                            <div class="text-xl font-bold text-slate-900">{item.rating}</div>
                            <div class="text-xs text-slate-500">{item.reviews_count} Google Yorumu</div>
                        </div>
                    </div>
                </div>

                <!-- Fotoğraf Galerisi -->
                {item.photos && item.photos.length > 0 && (
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
                        <img src={item.photos[0]} alt={item.name} loading="lazy" decoding="async" class="w-full h-64 md:h-80 object-cover rounded-xl shadow-sm" />
                        <div class="grid grid-rows-2 gap-4 hidden md:grid">
                            {item.photos[1] && <img src={item.photos[1].replace('maxwidth=800', 'maxwidth=400')} alt={`${item.name} detay`} loading="lazy" decoding="async" class="w-full h-[9.5rem] object-cover rounded-xl shadow-sm" />}
                            {item.photos[2] && <img src={item.photos[2].replace('maxwidth=800', 'maxwidth=400')} alt={`${item.name} görünüm`} loading="lazy" decoding="async" class="w-full h-[9.5rem] object-cover rounded-xl shadow-sm" />}
                        </div>
                    </div>
                )}

                <!-- IN-ARTICLE REKLAM ALANI 1 -->
                <AdSensePlaceholder type="in-article" className="my-8" />

                <!-- Yapay Zeka SEO Makalesi -->
                {articleHTML && (
                    <div class="mt-8 mb-8 bg-slate-50 p-6 md:p-10 rounded-2xl border border-slate-100 shadow-inner">
                        <article class="prose prose-slate prose-lg max-w-none prose-headings:text-slate-900 prose-a:text-blue-600 prose-img:rounded-xl" set:html={articleHTML} />
                    </div>
                )}

                <!-- İletişim ve Detaylar -->
                <div class="bg-slate-50 p-6 rounded-xl border border-slate-100 grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <h3 class="font-semibold text-slate-800 mb-4 flex items-center gap-2"><span>📌</span> İletişim Bilgileri</h3>
                        <ul class="space-y-3 text-slate-600 text-sm">
                            {item.address && <li><strong>Adres:</strong> {item.address}</li>}
                            {item.phone && <li><strong>Telefon:</strong> <a href={`tel:${item.phone}`} class="text-blue-600 hover:underline">{item.phone}</a></li>}
                            {item.website && <li><strong>Web Sitesi:</strong> <a href={item.website} target="_blank" rel="nofollow" class="text-blue-600 hover:underline">Ziyaret Et</a></li>}
                        </ul>
                    </div>
                    
                    <div>
                        <h3 class="font-semibold text-slate-800 mb-4 flex items-center gap-2"><span>🗺️</span> Haritada Gör</h3>
                        <p class="text-sm text-slate-600 mb-4">Mekana nasıl gideceğinizi öğrenmek için Google Haritalar'da yol tarifi alabilirsiniz.</p>
                        <a href={item.google_maps_url} target="_blank" rel="nofollow" class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-6 rounded-lg transition-colors w-full md:w-auto text-center">
                            Google Haritalar'da Aç
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- SAĞ SIDEBAR (Sticky Reklam Alanı) -->
        <div class="w-full lg:w-1/4">
            <div class="sticky top-24 space-y-6">
                <!-- SIDEBAR REKLAM ALANI 1 (Kare) -->
                <AdSensePlaceholder type="square" className="!my-0" />
                
                <!-- SIDEBAR REKLAM ALANI 2 (Dikey Opsiyonel) -->
                <div class="hidden lg:block">
                    <AdSensePlaceholder type="vertical" className="!my-0" />
                </div>
            </div>
        </div>

    </div>
</Layout>
