---
import Layout from '../layouts/Layout.astro';
import data from '../data/turizm_data.json';
---

<Layout title="Arama Sonuçları | SemtPusulası" description="Arama sonuçları.">
    <div class="max-w-6xl mx-auto mt-8 px-4 mb-24">
        
        <!-- Arama Başlığı -->
        <div class="mb-10 text-center md:text-left">
            <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 mb-4 tracking-tight" id="search-title">
                Arama Sonuçları
            </h1>
            <p class="text-slate-500 font-medium" id="search-subtitle">Sonuçlar yükleniyor...</p>
        </div>

        <!-- Arama Çubuğu (Sayfa İçi) -->
        <form action="/arama" method="GET" class="w-full max-w-2xl bg-white p-2 rounded-2xl border border-slate-200 shadow-sm flex focus-within:ring-2 focus-within:ring-blue-500/50 transition-all mb-12">
            <input type="text" name="q" id="page-search-input" placeholder="Farklı bir mekan ara..." class="w-full bg-transparent text-slate-800 placeholder-slate-400 text-lg px-4 py-3 focus:outline-none" />
            <button type="submit" class="bg-slate-900 hover:bg-slate-800 text-white font-bold px-8 py-3 rounded-xl transition-colors">
                Ara
            </button>
        </form>

        <!-- Sonuçlar Container -->
        <div id="results-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <!-- JS ile doldurulacak -->
        </div>

        <!-- Sonuç Yok Ekranı (Başlangıçta Gizli) -->
        <div id="no-results" class="hidden text-center py-24 bg-slate-50 rounded-3xl border border-dashed border-slate-300">
            <div class="text-6xl mb-6">🏜️</div>
            <h3 class="text-2xl font-extrabold text-slate-800 mb-2">Aradığınız mekan bulunamadı</h3>
            <p class="text-slate-500 max-w-md mx-auto mb-8" id="no-results-text">Eşleşen bir sonuç bulamadık. Lütfen farklı kelimelerle veya bölge isimleriyle tekrar deneyin.</p>
            <a href="/" class="inline-block bg-slate-900 hover:bg-slate-800 text-white font-bold px-8 py-3 rounded-xl transition-colors">
                Ana Sayfaya Dön
            </a>
        </div>
    </div>

    <script is:inline define:vars={{ searchData: data }}>
        document.addEventListener('DOMContentLoaded', () => {
            // URL'den 'q' parametresini al
            const urlParams = new URLSearchParams(window.location.search);
            const query = urlParams.get('q') || '';
            
            // Arama kutusuna yaz
            const searchInput = document.getElementById('page-search-input');
            if (searchInput && query) {
                searchInput.value = query;
            }

            const titleEl = document.getElementById('search-title');
            const subtitleEl = document.getElementById('search-subtitle');
            const containerEl = document.getElementById('results-container');
            const noResultsEl = document.getElementById('no-results');
            const noResultsTextEl = document.getElementById('no-results-text');

            if (!query) {
                // Arama kelimesi yoksa hepsini göster
                titleEl.textContent = "Tüm Mekanlar";
                renderResults(searchData);
                return;
            }

            titleEl.textContent = `"${query}" için arama sonuçları`;
            
            const lowerQuery = query.toLowerCase();
            const searchResults = searchData.filter(item => 
                (item.name && item.name.toLowerCase().includes(lowerQuery)) ||
                (item.address && item.address.toLowerCase().includes(lowerQuery)) ||
                (item.region && item.region.toLowerCase().includes(lowerQuery)) ||
                (item.category && item.category.toLowerCase().includes(lowerQuery))
            );

            renderResults(searchResults);

            function renderResults(results) {
                subtitleEl.innerHTML = `Toplam <span class="text-blue-600 font-bold">${results.length}</span> sonuç bulundu.`;
                
                if (results.length === 0) {
                    containerEl.innerHTML = '';
                    noResultsEl.classList.remove('hidden');
                    if(query) {
                        noResultsTextEl.textContent = `"${query}" ile eşleşen bir sonuç bulamadık. Lütfen farklı kelimelerle tekrar deneyin.`;
                    }
                    return;
                }

                noResultsEl.classList.add('hidden');
                containerEl.innerHTML = results.map(item => `
                    <a href="/mekan/${item.slug}" class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group flex flex-col">
                        <div class="relative h-56 bg-slate-100 overflow-hidden shrink-0">
                            ${item.photos && item.photos.length > 0 ? 
                                `<img src="${item.photos[0]}" alt="${item.name}" loading="lazy" decoding="async" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />` 
                                : 
                                `<div class="w-full h-full flex items-center justify-center text-slate-400 font-medium">Fotoğraf Yok</div>`
                            }
                            <div class="absolute top-4 right-4 bg-white/95 backdrop-blur-md px-3 py-1.5 rounded-xl text-sm font-bold text-slate-800 flex items-center gap-1.5 shadow-sm">
                                <span class="text-yellow-500">⭐</span> ${item.rating || "Yeni"}
                            </div>
                        </div>
                        <div class="p-6 flex flex-col flex-grow">
                            <div class="flex gap-2 mb-3">
                                <span class="text-xs font-bold text-blue-600 uppercase tracking-widest bg-blue-50 px-2 py-1 rounded w-max">${item.category}</span>
                                <span class="text-xs font-bold text-slate-500 uppercase tracking-widest bg-slate-100 px-2 py-1 rounded w-max">${item.region}</span>
                            </div>
                            <h2 class="text-xl font-bold text-slate-900 mb-3 group-hover:text-blue-600 transition-colors line-clamp-1">${item.name}</h2>
                            <p class="text-sm text-slate-500 line-clamp-2 mb-4 flex-grow">${item.address}</p>
                            
                            <div class="mt-auto pt-4 border-t border-slate-100 flex items-center justify-between">
                                <div class="text-sm font-medium text-slate-500 flex items-center gap-1.5">
                                    <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z"></path></svg>
                                    ${item.reviews_count || 0} Yorum
                                </div>
                            </div>
                        </div>
                    </a>
                `).join('');
            }
        });
    </script>
</Layout>
